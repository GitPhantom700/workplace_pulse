# ==============================================================================
# WorkplacePulse — Environment Configuration Template
# Google Cloud Run AI Challenge 
# ==============================================================================
# Copy this file to .env before starting the application locally or via Docker:
#   cp .env.example .env
#
# WorkplacePulse features a zero-friction Sandbox Mode (DEMO_MODE=true) which
# allows full evaluation of all features without requiring active GCP billing,
# live Firebase configuration, or API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Mode & Server Binding
# ------------------------------------------------------------------------------
# Options: development | production | test
ENV=development

# Port to bind the FastAPI / Uvicorn server (Default: 8080)
# In Google Cloud Run, this is automatically injected via the $PORT environment variable.
PORT=8080

# ------------------------------------------------------------------------------
# 2. Authentication & Zero-Friction Sandbox Mode
# ------------------------------------------------------------------------------
# When DEMO_MODE=true (Default for local testing):
#   - Frontend runs an instant mock Google SSO session.
#   - Backend accepts 'demo-*' bearer tokens without live Firebase Admin verification.
#   - Firestore writes fall back to resilient in-memory audit logs if offline.
#
# When DEMO_MODE=false (Production Cloud Run):
#   - Strict Firebase Admin SDK token decoding and cryptographic signature verification.
#   - Unauthenticated requests and invalid bearer tokens return 401 Unauthorized.
DEMO_MODE=true

# ------------------------------------------------------------------------------
# 3. Google Gemini API Configuration (Zero Hardcoding)
# ------------------------------------------------------------------------------
# Local Development / Sandbox:
#   Provide your Google AI Studio API key here for direct local inference.
#   Get a free Gemini API key: https://aistudio.google.com/
#
# Production Cloud Run:
#   Leave blank. The backend dynamically resolves 'GEMINI_API_KEY' from
#   Google Cloud Secret Manager using Application Default Credentials (ADC).
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Google Cloud & Firebase Project Identifiers
# ------------------------------------------------------------------------------
# GCP Project ID required for Cloud Secret Manager and Cloud Firestore in production.
# In local Sandbox / Demo Mode, this can remain default or use a placeholder.
GOOGLE_CLOUD_PROJECT=workplace-pulse-dev
GCP_PROJECT_ID=workplace-pulse-dev
FIREBASE_PROJECT_ID=workplace-pulse-dev

# Path to Google Application Default Credentials JSON (Optional for local live GCP testing)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-adminsdk.json

# ------------------------------------------------------------------------------
# 5. Security & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (without trailing slashes).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Standout Feature: Webhook & Runbook HMAC Security
# ------------------------------------------------------------------------------
# Secret key used to generate HMAC-SHA256 signatures for generic webhook dispatches
# and IT incident runbook automation notifications.
WEBHOOK_SIGNING_SECRET=pulse_dev_webhook_signing_secret_key_32bytes_min

# ------------------------------------------------------------------------------
# 7. Local Cloud Firestore Emulator (Optional)
# ------------------------------------------------------------------------------
# If running with the local Firestore emulator (via Docker Compose profile: emulator),
# uncomment the line below:
# FIRESTORE_EMULATOR_HOST=localhost:8085
